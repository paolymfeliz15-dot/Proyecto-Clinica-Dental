@{
    ViewData["Title"] = "Buzón de Sugerencias";
}

<div class="container mt-4" style="max-width: 500px;">
    <h2 class="mb-4">Buzón de Sugerencias</h2>
    <p class="text-muted">Tu opinión nos ayuda a mejorar. Cuéntanos qué podemos hacer mejor.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    @if (ViewBag.Exito == true)
    {
        <div class="alert alert-success">@ViewBag.Mensaje</div>
    }

    <form method="post" asp-action="Crear">
        <div class="mb-3">
            <label class="form-label">Tu sugerencia</label>
            <textarea name="mensaje" class="form-control" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary w-100">Enviar</button>
    </form>

    <a asp-controller="PacienteDashboard" asp-action="Index" class="btn btn-link w-100 mt-2">← Volver al panel</a>
</div>
