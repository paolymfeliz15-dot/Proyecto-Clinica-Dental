@{
    ViewData["Title"] = "Panel de Paciente";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Bienvenido/a, @ViewBag.NombreCompleto</h2>
        <a asp-controller="Cuenta" asp-action="Logout" class="btn btn-outline-danger">Cerrar sesión</a>
    </div>

    @* --- Inicio del nuevo aviso de cita --- *@
    @{
        var proximaCita = ViewBag.ProximaCita as AuraDental.Dominio.Entidades.Cita;
    }

    @if (proximaCita != null)
    {
        <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
            <span style="font-size: 1.3rem;">🔔</span>
            <div>
                <strong>Recordatorio:</strong> tienes una cita de <strong>@proximaCita.Servicio.Nombre</strong>
                el @proximaCita.BloqueAgenda.Fecha.ToString("dd/MM/yyyy") a las @proximaCita.BloqueAgenda.HoraInicio.ToString(@"hh\:mm").
            </div>
        </div>
    }
    @* --- Fin del aviso --- *@

    <h5 class="text-muted mb-3">Panel de Paciente</h5>

    <div class="row g-3">
        <div class="col-md-4">
            <a asp-controller="Citas" asp-action="Index" class="text-decoration-none">
                <div class="card p-3">
                    <h5>Mis Citas</h5>
                    <p class="text-muted mb-0">Ver y cancelar citas agendadas</p>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Disponibilidad" asp-action="Index" class="text-decoration-none">
                <div class="card p-3">
                    <h5>Consultar Disponibilidad</h5>
                    <p class="text-muted mb-0">Ver horarios por servicio</p>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="HistorialClinico" asp-action="Index" class="text-decoration-none">
                <div class="card p-3">
                    <h5>Historial Clínico</h5>
                    <p class="text-muted mb-0">Diagnósticos y tratamientos</p>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Resenas" asp-action="Crear" class="text-decoration-none">
                <div class="card p-3">
                    <h5>Dejar una Reseña</h5>
                    <p class="text-muted mb-0">Comparte tu experiencia</p>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Sugerencias" asp-action="Crear" class="text-decoration-none">
                <div class="card p-3">
                    <h5>Buzón de Sugerencias</h5>
                    <p class="text-muted mb-0">Comparte tus ideas</p>
                </div>
            </a>
        </div>
    </div>
</div>