@model List<AuraDental.Dominio.Entidades.Provincia>

@{
    ViewData["Title"] = "Gestionar Provincias";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestionar Provincias</h2>
        <a asp-action="Crear" class="btn btn-primary">+ Nueva</a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var provincia in Model)
            {
                <tr>
                    <td>@provincia.Nombre</td>
                    <td>
                        @if (provincia.Activa)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactiva</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Detalles" asp-route-id="@provincia.ProvinciaId" class="btn btn-sm btn-outline-info">Ver</a>
                        <a asp-action="Editar" asp-route-id="@provincia.ProvinciaId" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@provincia.ProvinciaId" />
                            <input type="hidden" name="activa" value="@(!provincia.Activa)" />
                            @if (provincia.Activa)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="AdministradorDashboard" asp-action="Index" class="btn btn-link">← Volver al panel</a>
</div>