@model AuraDental.Dominio.Entidades.Servicio

@{
    ViewData["Title"] = "Detalles del Servicio";
    var imagenActual = string.IsNullOrWhiteSpace(Model.ImagenUrl) ? "/images/default-service.svg" : Model.ImagenUrl;
}

<div class="container mt-4" style="max-width: 500px;">
    <h2>Detalles</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <img src="@imagenActual" alt="@Model.Nombre"
         style="width: 100%; height: 200px; object-fit: cover; border-radius: 12px;" class="mb-3" />

    <form asp-action="SubirImagen" method="post" enctype="multipart/form-data" class="mb-4">
        <input type="hidden" name="id" value="@Model.ServicioId" />
        <label class="form-label small">Cambiar imagen del servicio</label>
        <div class="input-group">
            <input type="file" name="imagen" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <button type="submit" class="btn btn-outline-primary">Subir</button>
        </div>
    </form>

    <dl class="row">
        <dt class="col-sm-4">Nombre</dt>
        <dd class="col-sm-8">@Model.Nombre</dd>

        <dt class="col-sm-4">Descripción</dt>
        <dd class="col-sm-8">@Model.Descripcion</dd>

        <dt class="col-sm-4">Duración</dt>
        <dd class="col-sm-8">@Model.DuracionMinutos minutos</dd>

        <dt class="col-sm-4">Precio</dt>
        <dd class="col-sm-8">@Model.Precio.ToString("C")</dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">@(Model.Activo ? "Activo" : "Inactivo")</dd>
    </dl>

    <a asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
</div>