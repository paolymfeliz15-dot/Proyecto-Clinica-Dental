@model AuraDental.Dominio.Entidades.Usuario

@{
    ViewData["Title"] = "Editar Perfil";
    var fotoActual = string.IsNullOrWhiteSpace(Model.FotoPerfilUrl) ? "/images/default-avatar.svg" : Model.FotoPerfilUrl;
}

<div class="container mt-5" style="max-width: 450px;">
    <h2 class="text-center mb-4">Editar Perfil</h2>

    <div class="text-center mb-4">
        <img id="previaFoto" src="@fotoActual" alt="Foto de perfil"
             style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%; border: 3px solid var(--aura-teal-200);" />

        @if (TempData["ErrorFoto"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["ErrorFoto"]</div>
        }

        <form asp-action="ActualizarFotoPerfil" method="post" enctype="multipart/form-data" class="mt-3">
            <label class="btn btn-outline-primary btn-sm" style="cursor:pointer;">
                Cambiar foto
                <input type="file" name="foto" id="inputFoto" accept=".jpg,.jpeg,.png,.webp" hidden onchange="mostrarPreviaYEnviar(this)" />
            </label>
        </form>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    @if (ViewBag.Exito != null)
    {
        <div class="alert alert-success">@ViewBag.Exito</div>
    }

    <form method="post" asp-action="EditarPerfil">
        <div class="mb-3">
            <label class="form-label">Nombre completo</label>
            <input type="text" name="nombreCompleto" class="form-control" value="@Model.NombreCompleto" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Correo electrónico</label>
            <input type="email" name="email" class="form-control" value="@Model.Email" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Guardar cambios</button>
    </form>
    <div class="text-center mt-3">
        <a asp-action="CambiarNombreUsuario" class="text-muted small">Cambiar solo mi nombre de usuario</a>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarPreviaYEnviar(input) {
            if (input.files && input.files[0]) {
                // Vista previa inmediata, antes incluso de que termine de subir
                const lector = new FileReader();
                lector.onload = e => document.getElementById('previaFoto').src = e.target.result;
                lector.readAsDataURL(input.files[0]);

                // Enviamos automáticamente el formulario de foto al elegir el archivo
                input.closest('form').submit();
            }
        }
    </script>
}