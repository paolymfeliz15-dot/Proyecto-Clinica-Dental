@model AuraDental.Aplicacion.Dtos.RegistroPacienteDto

@{
    ViewData["Title"] = "Registro";
}

<div class="container mt-5" style="max-width: 650px;">
    <h2 class="text-center mb-4">AuraDental</h2>
    <h4 class="text-center mb-4">Crear Cuenta</h4>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" asp-action="Registro">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombres</label>
                <input type="text" name="NombreCompleto" class="form-control" data-formato="nombre" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Apellidos</label>
                <input type="text" name="Apellidos" class="form-control" data-formato="nombre" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Número de cédula</label>
                <input type="text" name="Cedula" class="form-control" placeholder="000-0000000-0" data-formato="cedula" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Teléfono</label>
                <input type="tel" name="Telefono" class="form-control" placeholder="000-000-0000" data-formato="telefono" required />
            </div>
            <div class="col-12">
                <label class="form-label">Correo electrónico</label>
                <input type="email" name="Email" class="form-control" required />
            </div>
            <div class="col-12">
                <label class="form-label">Dirección (calle, número)</label>
                <input type="text" name="Direccion" class="form-control" placeholder="Opcional">
            </div>

            <div class="col-md-4">
                <label class="form-label">País</label>
                <select id="RegistroPais" name="Pais" class="form-select" required>
                    <option value="">Selecciona...</option>
                    @foreach (var pais in (List<string>)ViewBag.Paises)
                    {
                        <option value="@pais">@pais</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Estado / Provincia</label>
                <select id="RegistroEstadoProvincia" name="EstadoProvincia" class="form-select" placeholder="Opcional">
                    <option value="">Selecciona un país</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Ciudad</label>
                <select id="RegistroCiudad" name="Ciudad" class="form-select" placeholder="Opcional">
                    <option value="">Selecciona un estado</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Sector / Barrio</label>
                <input type="text" name="Sector" class="form-control" placeholder="Opcional">
            </div>

            <div class="col-12">
                <label class="form-label">Contraseña</label>
                <div class="input-group">
                    <input type="password" id="RegistroPassword" name="password" class="form-control" required />
                    <button type="button" class="btn btn-outline-secondary aura-toggle-password" data-target="RegistroPassword">👁</button>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success w-100 mt-4">Registrarme</button>
    </form>

    <p class="text-center mt-3">
        ¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión aquí</a>
    </p>
</div>

@section Scripts {
    <script src="~/js/aura-formularios.js"></script>
    <script>
        initCascadaUbicacion('Registro');
    </script>
}