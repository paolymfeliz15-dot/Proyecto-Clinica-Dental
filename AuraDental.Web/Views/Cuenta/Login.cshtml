@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center mb-4">AuraDental</h2>
    <h4 class="text-center mb-4">Iniciar Sesión</h4>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (ViewBag.MostrarReenviar == true)
    {
        <form asp-action="ReenviarVerificacion" method="post" class="mb-3">
            <input type="hidden" name="email" value="@ViewBag.EmailPendiente" />
            <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Reenviar correo de verificación</button>
        </form>
    }

    @if (TempData["MensajeReenvio"] != null)
    {
        <div class="alert alert-info">@TempData["MensajeReenvio"]</div>
    }

    <form method="post" asp-action="Login">
        <div class="mb-3">
            <label class="form-label">Correo electrónico o usuario</label>
            <input type="text" name="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <div class="input-group">
                <input type="password" id="LoginPassword" name="password" class="form-control" required />
                <button type="button" class="btn btn-outline-secondary aura-toggle-password" data-target="LoginPassword">👁</button>
            </div>
        </div>
        <button type="submit" class="btn btn-primary w-100">Ingresar</button>
    </form>

    <p class="text-center mt-3">
        ¿No tienes cuenta? <a asp-action="Registro">Regístrate aquí</a>
    </p>

    @section Scripts {
        <script src="~/js/aura-formularios.js"></script>
    }
</div>