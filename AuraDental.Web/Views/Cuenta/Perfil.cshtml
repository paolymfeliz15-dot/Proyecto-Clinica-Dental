@model AuraDental.Dominio.Entidades.Usuario

@{
    ViewData["Title"] = "Mi Perfil";
    var foto = string.IsNullOrWhiteSpace(Model.FotoPerfilUrl) ? "/images/default-avatar.svg" : Model.FotoPerfilUrl;
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="text-center mb-4">
        <img src="@foto" alt="Foto de perfil"
             style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%; border: 3px solid var(--aura-navy-100);" />
        <h2 class="mt-3 mb-0">@Model.NombreCompleto @Model.Apellidos</h2>
        <p class="text-muted">@Model.Email</p>
    </div>

    <div class="card p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Cédula</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Cedula) ? "—" : Model.Cedula)</dd>

            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)</dd>

            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Direccion) ? "—" : Model.Direccion)</dd>

            <dt class="col-sm-4">País</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Pais) ? "—" : Model.Pais)</dd>

            <dt class="col-sm-4">Estado / Provincia</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.EstadoProvincia) ? "—" : Model.EstadoProvincia)</dd>

            <dt class="col-sm-4">Ciudad</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Ciudad) ? "—" : Model.Ciudad)</dd>

            <dt class="col-sm-4">Sector</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Sector) ? "—" : Model.Sector)</dd>
        </dl>
    </div>

    <a asp-action="EditarPerfil" class="btn btn-primary w-100 mt-4">Editar Perfil</a>
</div>