@{
    ViewData["Title"] = "Cambiar Nombre de Usuario";
}

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center mb-4">Cambiar Nombre de Usuario</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    @if (ViewBag.Exito != null)
    {
        <div class="alert alert-success">@ViewBag.Exito</div>
    }

    <p class="text-muted">Nombre actual: <strong>@ViewBag.NombreActual</strong></p>

    <form method="post" asp-action="CambiarNombreUsuario">
        <div class="mb-3">
            <label class="form-label">Nuevo nombre</label>
            <input type="text" name="nuevoNombre" class="form-control" required minlength="2" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Actualizar</button>
    </form>

    <a asp-action="EditarPerfil" class="btn btn-link w-100 mt-2">← Volver a Editar Perfil</a>
</div>